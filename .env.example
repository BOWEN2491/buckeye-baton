# Local persistent demo database. Never deploy local demo mode as a shared cloud database.
DATABASE_MODE=pglite
PGLITE_DATA_DIR=.data/pglite
# For hosted PostgreSQL, remove DATABASE_MODE and provide your own secret URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional P2 AI browsing introductions (server only; never commit real values):
# OPENAI_API_KEY=
# OPENAI_PROJECT_INTRO_MODEL=
