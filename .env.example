# Local persistent demo database. Never deploy local demo mode as a shared cloud database.
DATABASE_MODE=pglite
PGLITE_DATA_DIR=.data/pglite
# For hosted PostgreSQL, remove DATABASE_MODE and provide your own secret URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional P2 AI browsing introductions (server only; never commit real values):
# OPENAI_API_KEY=
# OPENAI_PROJECT_INTRO_MODEL=
# OPENAI_BASE_URL=   (optional; defaults to https://api.openai.com/v1)
# P4 automatic invitations: a continuously running Node server checks every 60 seconds when set to 1.
# Off by default. Never runs during `next build`. Uses this app's own database connection only.
# INVITATION_RUNNER_ENABLED=1

# P5 durable AI analysis runner (sustained Node only, checks every 5 seconds).
# AI_ANALYSIS_RUNNER_ENABLED=1
# Optional server-side GitHub API origin override for isolated tests only:
# GITHUB_API_BASE_URL=http://127.0.0.1:3510
